# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional local Google pilot. Private keys belong in .env.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_REVIEWS_ENABLED=true
GOOGLE_PLACES_MAX_REQUESTS_PER_SESSION=20

# Optional private accounts. Use the publishable key, with database RLS enabled.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
